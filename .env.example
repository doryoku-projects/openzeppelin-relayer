# General Relayer Configuration
API_KEY=your_generated_bearer_api_key_uuid
LOG_LEVEL=info
CONFIG_DIR=./config
CONFIG_FILE_NAME=config.json
WEBHOOK_SIGNING_KEY=your_webhook_signing_key_uuid
RATE_LIMIT_REQUESTS_PER_SECOND=100
RATE_LIMIT_BURST_SIZE=300
METRICS_ENABLED=true

# Port configuration (Railway will inject PORT, set APP_PORT=${{PORT}} in Railway)
APP_PORT=8080

# Redis configuration
# Local: redis://localhost:6379
# Railway: set REDIS_URL=${{REDIS_URL}} using the provisioned Redis service variables
REDIS_URL=redis://localhost:6379
REDIS_CONNECTION_TIMEOUT_MS=10000
REDIS_KEY_PREFIX=oz-relayer
QUEUE_BACKEND=redis
DISTRIBUTED_MODE=false

# RPC & Server Settings
RPC_TIMEOUT_MS=10000
ENABLE_SWAGGER=true

# AWS Credentials (For KMS Signer)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Project 1: CopyPools Config
COPYPOOLS_AWS_REGION=eu-west-1
COPYPOOLS_AWS_KMS_KEY_ID=arn:aws:kms:eu-west-1:257394478858:key/your-key
COPYPOOLS_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_or_quiknode_key
COPYPOOLS_MAINNET_RPC_URL=https://wild-special-slug.quiknode.pro/your_quiknode_key
COPYPOOLS_AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
COPYPOOLS_ARBITRUM_RPC_URL=https://api-arbitrum-mainnet-archive.n.dwellir.com/<token>
